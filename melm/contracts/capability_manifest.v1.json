{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "melm.capability_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "families"],
  "properties": {
    "schema_id": {"const": "melm.capability_manifest.v1"},
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["installed", "handler"],
        "properties": {
          "installed": {"type": "boolean"},
          "handler": {"type": "string", "minLength": 1}
        }
      },
      "minProperties": 1
    }
  }
}
