{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "melm.evidence_packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id", "items", "admitted_count",
    "blocked_keys", "boundary"
  ],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "value", "source", "license", "local_only"],
        "properties": {
          "key": {"type": "string"},
          "kind": {"type": "string"},
          "value": {"type": "string"},
          "source": {"type": "string"},
          "license": {"type": "string"},
          "local_only": {"type": "boolean"}
        }
      }
    },
    "admitted_count": {"type": "integer", "minimum": 0},
    "blocked_keys": {
      "type": "array",
      "items": {"type": "string"}
    },
    "boundary": {"type": "string"},
    "membrane_decision_id": {"type": "string"}
  }
}
